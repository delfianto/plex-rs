{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(cargo)",
      "Bash(rustc *)",
      "Bash(rustc)",
      "Bash(rustup *)",
      "Bash(rustup)",
      "Bash(rustfmt *)",
      "Bash(rust-analyzer *)",
      "Bash(RUSTDOCFLAGS=* cargo *)",
      "Bash(RUSTFLAGS=* cargo *)",
      "Bash(RUST_BACKTRACE=* cargo *)",
      "Bash(RUST_LOG=* cargo *)",
      "Bash(CARGO_TARGET_DIR=* cargo *)",
      "Bash(brew list *)"
    ]
  }
}
