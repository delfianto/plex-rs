# Credentials for the optional live integration tests (`--features live-tests`).
# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit it.
#
# Static X-Plex-Token for your account. Grab it from Plex Web:
#   any item -> ... / Get Info -> View XML -> copy the X-Plex-Token=... query param.
PLEX_TEST_TOKEN=your-x-plex-token-here

# Base URL of the Plex Media Server to test against (no trailing slash).
# A LAN address (http://192.168.x.x:32400) or a public/reverse-proxied HTTPS URL both work.
PLEX_TEST_BASEURL=https://plex.example.app
